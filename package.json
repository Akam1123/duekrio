{
  "name": "duekrio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs && node scripts/apply-pages-csp.mjs",
    "build:hosted": "tsc -b && vite build --base=/ --outDir dist-hosted && node scripts/prepare-hosted.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  }
}
